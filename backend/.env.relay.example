# iMessage relay (SPEC §11.1). Lives only on the relay Mac; copy to .env.relay.
QUESTLINE_API_URL=http://localhost:8000
# Same shared token as the API. Placeholder; replace before deployment.
API_TOKEN=local-development-only
WEB_BASE_URL=http://localhost:5173
IMSG_BIN=imsg
# RELAY_STATE_PATH=~/.questline/imessage-relay.json
RELAY_FLUSH_SECONDS=15
RELAY_FLUSH_MAX=20
# Self-account mode only: the relay owner's own phone (+15551234567) or email. Leave unset for a
# dedicated bot Apple ID.
# RELAY_SELF_HANDLE=
