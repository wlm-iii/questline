# Local development. For Supabase, copy its direct or session-pooler URI here.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://questline:questline@localhost:5432/questline
# Supabase example (keep sslmode=require):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
APP_ENV=development
# Shared demo access only, NOT per-user authentication. Replace before deployment.
API_TOKEN=local-development-only
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Only the deterministic fake provider is implemented in the scaffold.
PLANNER_PROVIDER=fake
# Reserved for provider implementations; never sent to the browser.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
