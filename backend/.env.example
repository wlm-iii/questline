# Local development. For Supabase, copy its direct or session-pooler URI here.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://questline:questline@localhost:5432/questline
# Supabase example (keep sslmode=require):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
APP_ENV=development
# Service/tooling token only; browsers use X-Member-Token from create/join.
# Replace before deployment. Never expose this in the frontend bundle.
API_TOKEN=local-development-only
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Fake providers are the default and make no paid calls.
# FakeMaps supports San Jose/Big Sur endpoints and McWay Falls/Big Sur Bakery waypoints.
# gemini enables place extraction only; Gemini plan builds still return 503.
# google enables Places resolution; real routes are not implemented yet.
PLANNER_PROVIDER=fake
MAPS_PROVIDER=fake
# Live-tested extraction model; verify access/quotas for your own project.
# Older 2.5 Flash-Lite may reject new projects even when model discovery lists it.
GEMINI_MODEL=gemini-3.1-flash-lite
# Single-process demo hosting fallback; otherwise run the separate worker.
RUN_WORKER_IN_PROCESS=false
# Server-side secrets only: never commit real keys or put them in VITE_* variables.
# Gemini extraction requires both this key and GEMINI_MODEL; use synthetic/consented chat.
GEMINI_API_KEY=
# Enable Places API (New) + billing; restrict this key to the API and set quotas/alerts.
# Google attribution and content-retention handling are required before public deployment.
GOOGLE_MAPS_API_KEY=
# Optional placeholders, unused by the current Supabase-as-PostgreSQL-only design.
# The frontend uses FastAPI and member tokens; it does not need Supabase credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
